        <file alias="bacterium.svg">assets/guide/bacterium.svg</file>
        <file alias="bacteria-swim.svg">assets/guide/bacteria-swim.svg</file>
        <file alias="phage.svg">assets/guide/phage.svg</file>
        <file alias="tree-of-life.svg">assets/guide/tree-of-life.svg</file>
